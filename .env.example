# Copiez ce fichier vers `.env.local` (jamais commité) puis remplissez les valeurs.
# Toutes les variables sont facultatives : sans elles, le site tourne sur son
# contenu intégré et l'administration travaille en mode local (ce navigateur).
#
# ⚠️ Les VITE_* sont figées dans le bundle AU MOMENT DU BUILD.
#    - en local : relancer `npm run dev` (ou `npm run build`) après modification ;
#    - sur Netlify : Project configuration > Environment variables, PUIS
#      Deploys > Trigger deploy > Clear cache and deploy site.
#    Guide complet : DEPLOY-NETLIFY.md

# ── Supabase (obligatoire pour publier réellement) ──────────────────────────
# Tableau de bord Supabase > Project Settings > API
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Accès à l'administration ───────────────────────────────────────────────
# L'admin sera reachable sur : https://votre-site/#/VITE_ADMIN_PATH
# Choisissez une valeur longue et aléatoire : c'est la première barrière d'accès.
VITE_ADMIN_PATH=admin-fbl-changez-moi

# ── Aperçu / démonstration (à laisser vide en production) ──────────────────
# 1 = l'administration s'affiche par défaut ; le site public se rejoint avec ?site=1
# VITE_PREVIEW_ADMIN=1

# ── Formulaire de contact (facultatif) ─────────────────────────────────────
# Webhook ou backend recevant les demandes (sinon, ouverture de l'e-mail).
# VITE_LEADS_ENDPOINT=https://exemple.tn/leads
